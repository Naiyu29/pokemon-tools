{
  "name": "Champions 對戰工具",
  "short_name": "Champions",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101418",
  "theme_color": "#101418",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "screenshot", "accept": ["image/png", "image/jpeg", "image/webp", "image/*"] }
      ]
    }
  }
}
